{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Beta: se despliega aparte del sitio actual. Al aprobarla se renombra a "wizard".
  "name": "wizard-beta",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true }
  // Secreto requerido:  npx wrangler secret put BACKUP_KEY   (32 bytes en base64)
}
